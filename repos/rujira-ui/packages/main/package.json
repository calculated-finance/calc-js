{
  "name": "rujira-main",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "NODE_OPTIONS='--max-old-space-size=16384' tsc && vite build",
    "build:win": "cmd /c \"set NODE_OPTIONS=--max-old-space-size=16384 && tsc && vite build\"",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "preview": "vite preview",
    "relay": "find . -type d -name '__generated__' -exec rm -r {} + && relay-compiler relay.config.json",
    "relay:win": "npx rimraf --glob \"src/**/__generated__\" && relay-compiler relay.config.json",
    "postinstall": "npm run copy-files",
    "copy-files": "mkdir -p public/charting-library && cp -R node_modules/charting_library/charting_library/bundles public/charting-library",
    "init-vultisig-sdk": "cp node_modules/@vultisig/sdk/dist/*.wasm node_modules/.vite/deps"
  },
  "dependencies": {
    "@absinthe/socket": "^0.2.1",
    "@absinthe/socket-relay": "^0.2.1",
    "@autorujira/workflow-launcher": "2.1.8",
    "@cosmjs/encoding": "^0.32.4",
    "@cosmjs/math": "^0.32.4",
    "@keplr-wallet/types": "^0.12.219",
    "@rive-app/react-canvas": "^4.24.0",
    "@rollup/plugin-inject": "^5.0.5",
    "@sentry/react": "^9.8.0",
    "@sentry/vite-plugin": "^3.2.2",
    "@vultisig/sdk": "0.22.7",
    "bitcoinjs-lib": "7.0.0-rc.0",
    "borsh": "0.6.0",
    "buffer": "^6.0.3",
    "charting_library": "git+ssh://git@github.com:RujiraNetwork/charting_library.git",
    "clsx": "^2.1.1",
    "crypto-browserify": "^3.12.1",
    "date-fns": "^4.1.0",
    "ethers": "^6.13.4",
    "html2canvas": "^1.4.1",
    "motion": "^11.12.0",
    "pako": "^2.1.0",
    "phoenix": "^1.7.19",
    "process": "^0.11.10",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-helmet": "^6.1.0",
    "react-hot-toast": "^2.4.1",
    "i18next": "^23.16.4",
    "react-i18next": "^15.1.1",
    "react-number-format": "^5.4.2",
    "react-relay": "^18.2.0",
    "react-router-dom": "^6.26.2",
    "react-tooltip": "^5.28.0",
    "recharts": "^2.13.3",
    "relay-runtime": "^18.2.0",
    "rujira.js": "workspace:*",
    "rujira.ui": "workspace:*",
    "three": "^0.181.2",
    "stream-browserify": "^3.0.0",
    "ton-core": "^0.53.0",
    "tiny-secp256k1": "^2.2.3",
    "tweetnacl-util": "^0.15.1",
    "vaul": "^1.1.1",
    "vite-plugin-commonjs-externals": "^0.1.4",
    "vite-plugin-node-polyfills": "^0.24.0",
    "vite-plugin-wasm": "^3.4.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/runtime": "^7.26.7",
    "@rollup/plugin-commonjs": "^28.0.9",
    "@rollup/plugin-dsv": "^3.0.5",
    "@types/absinthe__socket": "^0.2.6",
    "@types/pako": "^2.0.3",
    "@types/phoenix": "^1.6.6",
    "@types/react": "^18.3.4",
    "@types/react-dom": "^18.3.0",
    "@types/react-helmet": "^6.1.11",
    "@types/react-relay": "^16.0.6",
    "@types/relay-runtime": "^18.1.1",
    "@types/three": "^0.181.0",
    "@typescript-eslint/eslint-plugin": "^8.2.0",
    "@typescript-eslint/parser": "^8.2.0",
    "@vitejs/plugin-react-swc": "^3.5.0",
    "babel-plugin-relay": "^18.2.0",
    "eslint": "^8.57.0",
    "eslint-plugin-i18next-no-undefined-translation-keys": "^3.4.0",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.6",
    "graphql": "^16.9.0",
    "relay-compiler": "^18.2.0",
    "rimraf": "^6.0.0",
    "rollup-plugin-visualizer": "^5.12.0",
    "sass": "^1.77.8",
    "typescript": "^5.5.4",
    "vite": "^5.2.0",
    "vitest": "^1.6.0"
  }
}
