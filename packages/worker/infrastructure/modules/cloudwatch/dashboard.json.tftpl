{
  "widgets": [
    {
      "type": "log",
      "x": 0,
      "y": 47,
      "width": 24,
      "height": 7,
      "properties": {
        "query": ${error_log_query},
        "region": "${region}",
        "stacked": false,
        "title": "Error Logs",
        "view": "table",
        "queryLanguage": "CWLI"
      }
    },
    {
      "type": "log",
      "x": 0,
      "y": 40,
      "width": 24,
      "height": 7,
      "properties": {
        "query": ${execution_log_query},
        "region": "${region}",
        "stacked": false,
        "view": "table",
        "title": "Execution Logs",
        "queryLanguage": "CWLI"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 33,
      "width": 24,
      "height": 7,
      "properties": {
        "metrics": [
          [
            "AWS/ECS",
            "MemoryUtilization",
            "ServiceName",
            "${scheduler_service_name}",
            "ClusterName",
            "${cluster_name}"
          ],
          [
            ".",
            "CPUUtilization",
            ".",
            ".",
            ".",
            "."
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "${region}",
        "title": "Producer Infrastructure",
        "period": 60,
        "stat": "Average"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 13,
      "width": 24,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "AWS/SQS",
            "NumberOfMessagesSent",
            "QueueName",
            "${triggers_queue_name}",
            {
              "region": "${region}"
            }
          ],
          [
            ".",
            "NumberOfMessagesDeleted",
            ".",
            ".",
            {
              "region": "${region}"
            }
          ]
        ],
        "view": "timeSeries",
        "stacked": false,
        "region": "${region}",
        "period": 60,
        "stat": "Sum",
        "title": "Trigger Messages Sent/Deleted"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 26,
      "width": 24,
      "height": 7,
      "properties": {
        "metrics": ${executor_throttle_metrics},
        "view": "timeSeries",
        "stacked": false,
        "region": "${region}",
        "title": "Execution Lambda Throttles",
        "period": 10,
        "stat": "Sum"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 19,
      "width": 24,
      "height": 7,
      "properties": {
        "metrics": ${executor_error_metrics},
        "view": "timeSeries",
        "stacked": false,
        "region": "${region}",
        "title": "Execution Lambda Errors",
        "period": 10,
        "stat": "Sum"
      }
    },
    {
      "type": "metric",
      "x": 0,
      "y": 0,
      "width": 9,
      "height": 6,
      "properties": {
        "metrics": [
          [
            "Calc/Custom",
            "StrategyCount",
            "ChainId",
            "${chain_id}",
            {
              "region": "${region}",
              "label": "Strategies Created",
              "yAxis": "left"
            }
          ]
        ],
        "sparkline": true,
        "view": "singleValue",
        "region": "${region}",
        "period": 60,
        "stat": "Maximum",
        "title": "Total Strategies",
        "singleValueFullPrecision": false,
        "setPeriodToTimeRange": true,
        "stacked": true,
        "liveData": true
      }
    },
    {
      "type": "metric",
      "x": 9,
      "y": 0,
      "width": 15,
      "height": 6,
